# Скопируй этот файл как .env и заполни своими данными
# Затем запусти: source .env && python bot.py

# Токен бота от @BotFather
export BOT_TOKEN="1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ID или username твоего канала
# Если канал публичный — можно "@ROSTOVBETS"
# Если приватный — нужен числовой ID вида -1001234567890
export CHANNEL_ID="@ROSTOVBETS"

# Telegram ID администраторов через запятую (без пробелов)
# Свой ID можно узнать у @userinfobot
# Например: ты и твой админ
export ADMIN_IDS="123456789,987654321"
